---
import site from '../data/site.json';
import shared from '../data/shared.json';

// Thumb-reach actions on phones: the two things a buyer actually does.
// Hidden from large screens, where the header carries the same buttons.
const hidden = Astro.url.pathname.replace(/\/$/, '') === '/contact';
---

{
  !hidden && shared.mobileBar?.enabled && (
    <div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 border-t border-ink-900/10 bg-linen-50/95 backdrop-blur-md lg:hidden" style="padding-bottom: env(safe-area-inset-bottom)">
      <a href={`tel:${site.phoneHref}`} class="flex items-center justify-center gap-2 py-4 text-[0.7rem] tracking-widest text-ink-900 uppercase">
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M4 3h3l2 5-2.5 1.5a11 11 0 0 0 4 4L12 11l5 2v3a1 1 0 0 1-1 1A13 13 0 0 1 3 4a1 1 0 0 1 1-1z" stroke-linejoin="round"/></svg>
        {shared.mobileBar.callLabel}
      </a>
      <a href="/contact" class="flex items-center justify-center bg-ink-900 py-4 text-[0.7rem] tracking-widest text-linen-50 uppercase">
        {shared.mobileBar.inquireLabel}
      </a>
    </div>
  )
}
