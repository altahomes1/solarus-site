---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PageHero from '../components/PageHero.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import page from '../data/pages/amenities.json';

const library = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{jpg,jpeg,png,webp}', { eager: true });
const pick = (path: string) => (path ? library[path]?.default : undefined);
---

<BaseLayout title={page.header.eyebrow} description={page.seoDescription}>
  <PageHero eyebrow={page.header.eyebrow} title={page.header.title} intro={page.header.intro} image={page.header.image} imageAlt={page.header.imageAlt}>
  </PageHero>

  {
    page.groups.map((group, index) => (
      <section class:list={['py-12 sm:py-20', index % 2 === 1 && 'border-y border-linen-300 bg-linen-100']}>
        {(() => { const img = pick(group.image); return img && (
          <div class="mx-auto mb-14 max-w-7xl px-5 sm:px-8">
            <Image src={img} alt={group.imageAlt} widths={[800, 1280, 1920]} sizes="(min-width: 1280px) 1200px, 92vw" class="aspect-21/9 w-full object-cover" />
          </div>
        ); })()}
        <div class="mx-auto max-w-7xl px-5 sm:px-8">
          <div class="reveal grid gap-10 lg:grid-cols-12">
            <div class="lg:col-span-4">
              <h2 class="font-display text-3xl text-ink-900 sm:text-4xl">{group.title}</h2>
              <div class="rule mt-5"></div>
            </div>
            <ul class="grid gap-px bg-linen-300 sm:grid-cols-2 lg:col-span-8">
              {group.items.map((item) => (
                <li class="bg-linen-50 px-6 py-6">
                  <h3 class="text-[0.7rem] font-medium tracking-widest text-ink-900 uppercase">{item.name}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-ink-500">{item.description}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    ))
  }

  <section class="mx-auto max-w-7xl px-5 pb-20 sm:px-8 sm:pb-28">
    <div class="border border-linen-300 bg-linen-100 px-6 py-14 text-center sm:px-16">
      <SectionHeading eyebrow={page.cta.eyebrow} title={page.cta.title} align="center" />
      <a href="/availability" class="mt-9 inline-block bg-ink-900 px-8 py-4 text-[0.7rem] tracking-widest text-linen-50 uppercase transition-colors hover:bg-brass-600">
        {page.cta.button}
      </a>
    </div>
  </section>
</BaseLayout>
