---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import page from '../data/pages/visionaries.json';

// Headshots uploaded through the dashboard land in src/assets/team and are
// matched here by path, so they still get optimized at build time.
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/team/*.{jpg,jpeg,png,webp}', { eager: true });
---

<BaseLayout title={page.header.eyebrow} description={page.seoDescription}>
  <PageHero eyebrow={page.header.eyebrow} title={page.header.title} intro={page.header.intro} image={page.header.image} imageAlt={page.header.imageAlt}>
  </PageHero>

  <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-24">
    <div class="grid gap-16 sm:grid-cols-2">
      {
        page.people.map((person) => {
          const photo = photos[person.photo]?.default;
          return (
            <article class="reveal">
              {photo ? (
                <Image src={photo} alt={`Portrait of ${person.name}`} widths={[400, 700, 1000]} sizes="(min-width: 640px) 45vw, 92vw" class="aspect-4/5 w-full bg-linen-200 object-cover object-top" />
              ) : (
                <div class="aspect-4/5 w-full bg-linen-200" />
              )}
              <h2 class="mt-6 font-display text-3xl text-ink-900">{person.name}</h2>
              <p class="eyebrow mt-2">{person.role}</p>
              <p class="mt-4 text-sm leading-relaxed text-ink-500 sm:text-base">{person.bio}</p>
            </article>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
