---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import UnitCard from '../components/UnitCard.astro';
import site from '../data/site.json';
import home from '../data/pages/home.json';
import { availabilitySummary, defaultSort, units } from '../lib/units';

import hero from '../assets/hero.jpg';
import lobby from '../assets/home-lobby.jpg';
import residence from '../assets/home-residence.jpg';
import amenity from '../assets/home-amenity.jpg';

// Any image under src/assets can be chosen from the dashboard for the
// discovery cards and feature rows; it is matched here by path.
const library = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{jpg,jpeg,png,webp}', { eager: true });
const pick = (path: string) => library[path]?.default;

const summary = availabilitySummary();
const term = site.unitTerm;
const offersBoth = summary.forSale > 0 && summary.forLease > 0;
const availabilitySentence =
  `${summary.available} of ${summary.total} ${summary.total === 1 ? term.singular : term.plural} ` +
  `${summary.available === 1 ? 'is' : 'are'} currently available` +
  (offersBoth ? ` — ${summary.forSale} for sale and ${summary.forLease} for lease.` : '.');

const featured = defaultSort(units.filter((unit) => unit.status === 'available')).slice(0, 3);
const usd = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
---

<BaseLayout title={`${site.name} — ${site.tagline}`} suffixTitle={false} description={home.seoDescription}>
  <!-- Hero: full-bleed rendering, short line, key numbers along the bottom -->
  <section class="relative isolate flex min-h-[88svh] flex-col justify-end overflow-hidden bg-ink-900 sm:min-h-[92svh]">
    <Image
      src={hero}
      alt={home.heroImageAlt}
      widths={[640, 1024, 1600, 2048, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink-950/90 via-ink-950/25 to-ink-950/30"></div>

    <div class="mx-auto w-full max-w-7xl px-5 pt-24 pb-8 sm:px-8 sm:pt-32 sm:pb-20">
      {
        home.heroBadge && (
          <p class="inline-block border border-linen-50/40 px-3 py-1.5 text-[0.6rem] tracking-widest text-linen-100 uppercase backdrop-blur-sm">
            {home.heroBadge}
          </p>
        )
      }
      <p class="eyebrow mt-4 text-brass-300 sm:mt-6">
        {site.address.city}, {site.address.state} &middot; {home.heroEyebrow}
      </p>
      <h1 class="mt-4 max-w-4xl font-display text-[2.6rem] leading-[1.05] text-linen-50 sm:mt-5 sm:text-7xl sm:leading-[1.02] lg:text-[6.5rem]">
        {site.tagline}
      </h1>

      <div class="mt-7 grid grid-cols-2 gap-2.5 sm:mt-10 sm:flex sm:items-center sm:gap-3">
        <a href="/availability" class="bg-linen-50 px-3 py-3.5 text-center text-[0.65rem] tracking-[0.14em] text-ink-900 uppercase transition-colors hover:bg-brass-300 sm:px-8 sm:py-4 sm:text-[0.7rem] sm:tracking-widest">
          {home.heroButtons.primary}
        </a>
        <a href="/contact" class="border border-linen-50/40 px-3 py-3.5 text-center text-[0.65rem] tracking-[0.14em] text-linen-50 uppercase transition-colors hover:border-linen-50 hover:bg-linen-50/10 sm:px-8 sm:py-4 sm:text-[0.7rem] sm:tracking-widest">
          {home.heroButtons.secondary}
        </a>
      </div>

      {
        home.heroStatsInHero && (
          <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-4 border-t border-linen-50/15 pt-5 sm:mt-14 sm:grid-cols-4 sm:gap-px sm:pt-8">
            {site.stats.map((stat) => (
              <div class="sm:py-2 sm:pr-6">
                <dd class="font-display text-xl text-linen-50 sm:text-4xl">{stat.value}</dd>
                <dt class="mt-0.5 text-[0.55rem] tracking-widest text-linen-200/80 uppercase sm:mt-1 sm:text-[0.6rem]">{stat.label}</dt>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </section>

  <!-- Introduction -->
  <section class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-28">
    <div class="reveal grid gap-14 lg:grid-cols-12 lg:items-center lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHeading eyebrow={home.introSection.eyebrow} title={home.introSection.title} intro={home.introSection.intro} />
        <div class="mt-10 space-y-8">
          {
            home.pillars.map((pillar) => (
              <div class="border-l border-brass-300 pl-6">
                <h3 class="font-display text-2xl text-ink-900">{pillar.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-500">{pillar.body}</p>
              </div>
            ))
          }
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4 lg:col-span-7">
        <Image src={residence} alt={home.introImages.alt1} widths={[400, 700, 1000]} sizes="(min-width: 1024px) 28vw, 45vw" class="aspect-3/4 w-full object-cover" />
        <div class="grid gap-4">
          <Image src={lobby} alt={home.introImages.alt2} widths={[400, 700, 1000]} sizes="(min-width: 1024px) 28vw, 45vw" class="aspect-4/3 w-full object-cover" />
          <Image src={amenity} alt={home.introImages.alt3} widths={[400, 700, 1000]} sizes="(min-width: 1024px) 28vw, 45vw" class="aspect-4/3 w-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <!-- Discover: one card per section of the site -->
  {
    home.discover.length > 0 && (
      <section class="border-y border-linen-300 bg-linen-100 py-14 sm:py-28">
        <div class="mx-auto max-w-7xl px-5 sm:px-8">
          <SectionHeading eyebrow={home.discoverSection.eyebrow} title={home.discoverSection.title} />
          <div class="reveal mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {home.discover.map((card, index) => {
              const img = pick(card.image);
              return (
                <a
                  href={card.link}
                  class:list={['group relative flex min-h-[15rem] flex-col justify-end overflow-hidden bg-ink-900 p-5 text-linen-50 sm:min-h-[22rem] sm:p-7', index === 0 && 'sm:col-span-2 lg:col-span-1 lg:row-span-2 lg:min-h-[46rem]']}
                >
                  {img && (
                    <Image src={img} alt="" aria-hidden="true" widths={[500, 800, 1200]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 92vw" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" />
                  )}
                  <div class="absolute inset-0 bg-gradient-to-t from-ink-950/85 via-ink-950/30 to-transparent" />
                  <div class="relative">
                    <h3 class="font-display text-3xl">{card.title}</h3>
                    <p class="mt-2 max-w-sm text-sm leading-relaxed text-linen-200">{card.text}</p>
                    <span class="mt-5 inline-block border-b border-brass-300 pb-1 text-[0.65rem] tracking-widest text-brass-300 uppercase">{card.linkLabel}</span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  <!-- Feature stories: alternating image and text -->
  {
    home.features.map((feature) => {
      const img = pick(feature.image);
      const imageRight = feature.imageSide !== 'left';
      return (
        <section class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-20">
          <div class="reveal grid items-center gap-10 lg:grid-cols-12 lg:gap-16">
            <div class:list={['lg:col-span-7', imageRight ? 'lg:order-2' : 'lg:order-1']}>
              {img && <Image src={img} alt={feature.imageAlt} widths={[640, 1000, 1400]} sizes="(min-width: 1024px) 58vw, 92vw" class="aspect-16/10 w-full object-cover" />}
            </div>
            <div class:list={['lg:col-span-5', imageRight ? 'lg:order-1' : 'lg:order-2']}>
              <SectionHeading eyebrow={feature.eyebrow} title={feature.title} intro={feature.body} />
              <a href={feature.link} class="mt-5 inline-block border-b border-brass-500 py-3 text-[0.7rem] tracking-widest text-ink-900 uppercase transition-colors hover:text-brass-600">
                {feature.linkLabel}
              </a>
            </div>
          </div>
        </section>
      );
    })
  }

  <!-- Featured availability -->
  <section class="border-y border-linen-300 bg-linen-100 py-14 sm:py-28">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="reveal flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
        <SectionHeading eyebrow={home.featuredSection.eyebrow} title={home.featuredSection.title} intro={availabilitySentence} />
        <a href="/availability" class="shrink-0 border border-ink-900 px-7 py-4 text-center text-[0.7rem] tracking-widest text-ink-900 uppercase transition-colors hover:bg-ink-900 hover:text-linen-50">
          {home.featuredButton} {summary.total} {term.plural}
        </a>
      </div>
      <div class="reveal mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((unit) => <UnitCard unit={unit} />)}
      </div>
      {
        offersBoth && (
          <div class="reveal mt-10 flex flex-wrap gap-3">
            {summary.saleFrom && (
              <a href="/availability?type=sale" class="border border-linen-300 bg-linen-50 px-6 py-4 text-sm text-ink-700 transition-colors hover:border-brass-300">
                {home.priceChips.saleFrom} <span class="font-medium text-ink-900">{usd.format(summary.saleFrom)}</span>
              </a>
            )}
            {summary.leaseFrom && (
              <a href="/availability?type=lease" class="border border-linen-300 bg-linen-50 px-6 py-4 text-sm text-ink-700 transition-colors hover:border-brass-300">
                {home.priceChips.leaseFrom} <span class="font-medium text-ink-900">{usd.format(summary.leaseFrom)}/mo</span>
              </a>
            )}
          </div>
        )
      }
    </div>
  </section>

  <!-- Amenities list -->
  <section class="mx-auto max-w-7xl px-5 py-20 sm:px-8 sm:py-28">
    <div class="reveal grid gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHeading eyebrow={home.amenitiesSection.eyebrow} title={home.amenitiesSection.title} intro={home.amenitiesSection.intro} />
      </div>
      <ul class="grid gap-px bg-linen-300 sm:grid-cols-2 lg:col-span-7">
        {
          home.amenities.map((item) => (
            <li class="flex items-start gap-3 bg-linen-50 px-5 py-5 text-sm text-ink-700">
              <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-brass-500" aria-hidden="true"></span>
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="mx-auto max-w-7xl px-5 pb-20 sm:px-8 sm:pb-28">
    <div class="reveal border border-linen-300 bg-linen-100 px-6 py-16 text-center sm:px-16 sm:py-20">
      <SectionHeading eyebrow={home.ctaSection.eyebrow} title={home.ctaSection.title} align="center" intro={home.ctaSection.intro} />
      <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/contact" class="bg-ink-900 px-8 py-4 text-[0.7rem] tracking-widest text-linen-50 uppercase transition-colors hover:bg-brass-600">
          {home.ctaButtons.primary}
        </a>
        <a href={`tel:${site.phoneHref}`} class="border border-ink-900 px-8 py-4 text-[0.7rem] tracking-widest text-ink-900 uppercase transition-colors hover:bg-ink-900 hover:text-linen-50">
          {home.ctaButtons.call} {site.phone}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
